{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agulater:specialists:v1",
  "title": "Prepared Specialist Registry v1",
  "type": "object",
  "required": ["format", "specialists"],
  "properties": {
    "format": { "const": "agulater/specialists/v1" },
    "specialists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "description", "accepts", "workspace_effect", "launch_path", "snapshot_path", "requirements", "defaults", "handoff_format"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "accepts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "workspace_effect": { "enum": ["read", "write"] },
          "launch_path": { "type": "string", "minLength": 1 },
          "snapshot_path": { "type": "string", "minLength": 1 },
          "requirements": { "$ref": "#/$defs/requirements" },
          "defaults": { "$ref": "#/$defs/defaults" },
          "handoff_format": { "const": "agul/handoff/v1" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positive": { "type": "integer", "minimum": 1 },
    "requirements": {
      "type": "object",
      "required": ["min_context_window", "capabilities"],
      "properties": {
        "min_context_window": { "$ref": "#/$defs/positive" },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": ["reasoning_effort", "max_rounds", "max_tool_calls", "max_tokens", "timeout_seconds"],
      "properties": {
        "reasoning_effort": { "type": "string", "minLength": 1 },
        "max_rounds": { "$ref": "#/$defs/positive" },
        "max_tool_calls": { "$ref": "#/$defs/positive" },
        "max_tokens": { "$ref": "#/$defs/positive" },
        "timeout_seconds": { "$ref": "#/$defs/positive" }
      },
      "additionalProperties": false
    }
  }
}

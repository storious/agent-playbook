{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agulater:snapshot:v1",
  "title": "Agulater Runtime Snapshot v1",
  "type": "object",
  "required": ["format", "package", "instructions", "resources", "dependencies"],
  "properties": {
    "format": { "const": "agulater/snapshot/v1" },
    "package": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "instructions": {
      "type": "object",
      "required": ["source", "path"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["skills", "plugins", "contexts", "packages"],
      "properties": {
        "skills": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "contexts": { "type": "array", "items": { "$ref": "#/$defs/context" } },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/package_entry" } }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": ["skills", "plugins", "packages"],
      "properties": {
        "skills": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "plugins": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/package_entry" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "oneOf": [
        { "type": "object", "required": ["type", "path"], "properties": { "type": { "const": "resource" }, "path": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "catalog" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "host" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "path"], "properties": { "type": { "const": "path" }, "path": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["type", "url"], "properties": { "type": { "const": "git" }, "url": { "type": "string" }, "subdir": { "type": "string" }, "ref": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["id", "version", "source", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["id", "version", "source", "path", "description", "load"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "path": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "load": { "enum": ["eager", "on_demand"] }
      },
      "additionalProperties": false
    },
    "package_entry": {
      "type": "object",
      "required": ["id", "version", "source", "path", "launch_path", "snapshot_path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/source" },
        "path": { "type": "string", "minLength": 1 },
        "launch_path": { "type": "string", "minLength": 1 },
        "snapshot_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
